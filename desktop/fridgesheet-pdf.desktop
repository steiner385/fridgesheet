[Desktop Entry]
Type=Application
Name=Kids' Sheet (PDF only)
Comment=Refresh Canvas + HAC and open today's open-work sheet as a PDF; prints nothing
Exec=bash -c '"$HOME/fridgesheet/scripts/fridgesheet-desktop.sh" pdf'
Icon=x-office-document
Terminal=true
Categories=Office;
Keywords=fridgesheet;school;canvas;grades;homework;
