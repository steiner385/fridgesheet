[Unit]
Description=Refresh Canvas + HAC snapshot for lakota-grades-mcp
After=network-online.target

[Service]
Type=oneshot
# Optional: this is already the default. Change it to read settings from elsewhere.
Environment=LAKOTA_ENV_FILE=%h/.lakota-grades/.env
ExecStart=%h/lakota-grades-mcp/.venv/bin/lakota-grades refresh
# A full pull (3 kids x 2 sites, plus a possible login) runs 1-3 min. systemd's default
# start timeout is 90s, which would SIGTERM the refresh partway through every time.
TimeoutStartSec=900
