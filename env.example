# Copy to ~/.lakota-grades/.env ONLY if you are not using a 1Password mounted .env.
# Preferred: let 1Password Environments mount this file so no plaintext is on disk.

# Option A (values supplied by the 1Password mount):
# LAKOTA_ONELOGIN_USERNAME=
# LAKOTA_ONELOGIN_PASSWORD=

# Option B (op CLI secret references; resolved with `op read` at login time):
# LAKOTA_OP_USERNAME_REF=op://Private/Lakota OneLogin/username
# LAKOTA_OP_PASSWORD_REF=op://Private/Lakota OneLogin/password

# Optional overrides
# LAKOTA_CANVAS_BASE=https://lakota.instructure.com
# LAKOTA_HAC_BASE=https://hac.lakotainline.com/HomeAccess
# LAKOTA_ONELOGIN_HOST=lakota.onelogin.com
# LAKOTA_HEADLESS=1
# LAKOTA_CACHE_TTL_MINUTES=180
