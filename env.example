# Optional settings for lakota-grades. Copy to ~/.lakota-grades/.env, which is read
# automatically; set LAKOTA_ENV_FILE only to use a file somewhere else.
# NO CREDENTIALS BELONG IN THIS FILE.

# Credentials live in the GNOME keyring (freedesktop Secret Service):
#   lakota-grades set-credentials
# stores them under service=lakota-grades, keys "username" and "password".
# They are encrypted at rest under your login password, unlocked by PAM at desktop
# login, and readable by the unattended systemd --user refresh timer.

# Alternative A -- supply them in the environment instead (1Password Environments
# mount, `op run --env-file=...`, or a file you manage yourself). Plaintext at rest:
# LAKOTA_ONELOGIN_USERNAME=
# LAKOTA_ONELOGIN_PASSWORD=

# Alternative B -- 1Password CLI secret references, resolved with `op read` at login
# time. Needs someone present to approve the desktop-app prompt, so it is not suitable
# for the timer. Address items by UUID: op:// rejects '(' and ')' in an item title.
# LAKOTA_OP_USERNAME_REF=op://Private/<item-uuid>/username
# LAKOTA_OP_PASSWORD_REF=op://Private/<item-uuid>/password

# Optional overrides
# LAKOTA_CANVAS_BASE=https://lakota.instructure.com
# LAKOTA_HAC_BASE=https://hac.lakotainline.com/HomeAccess
# LAKOTA_ONELOGIN_HOST=lakota.onelogin.com
# LAKOTA_KEYRING_SERVICE=lakota-grades
# LAKOTA_HEADLESS=1
# LAKOTA_CACHE_TTL_MINUTES=180
# LAKOTA_PRINTER=            # printer name; blank = system default (lpstat -a lists them)
# LAKOTA_NICKNAMES=Alex=Al,Katherine=Kate   # snapshot first name = name printed on the sheet
# Most settings can also live in ~/.lakota-grades/config.toml; the environment wins.

# print-sheet: also save each PDF here as <year>/<date> Open Work.pdf (e.g. a Drive mount).
# LAKOTA_SHEETS_ARCHIVE=/path/to/a/folder/people/look/in/Open Work Sheets
